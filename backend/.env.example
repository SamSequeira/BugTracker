# BugTracker Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AWS / S3 ────────────────────────────────────────────────────────────────
# Your S3 bucket name (must already exist).
S3_BUCKET_NAME=your-bugtracker-bucket

# AWS region where the bucket lives (e.g. us-east-1, eu-west-2).
AWS_REGION=us-east-1

# Access credentials — leave blank when running on EC2/ECS/Lambda with
# an IAM role attached; required for local development.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 key prefix for uploaded repository ZIPs (default: repositories).
S3_PREFIX=repositories

# How long pre-signed download URLs remain valid in seconds (default: 3600).
S3_PRESIGNED_EXPIRY=3600

# Set to false to skip S3 uploads during local development without
# removing the other AWS vars.
S3_ENABLED=true

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/bugtracker.db

# ── AI (optional) ───────────────────────────────────────────────────────────
# Anthropic Claude — static analysis works without this.
ANTHROPIC_API_KEY=sk-ant-...

# ── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Scanner limits ──────────────────────────────────────────────────────────
MAX_FILES_PER_SCAN=500
CLONE_TIMEOUT_SECONDS=60

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
