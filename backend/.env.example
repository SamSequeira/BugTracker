# BugTracker Backend Environment Variables
# Copy this file to .env and fill in your values

# Database — defaults to local SQLite if not set
DATABASE_URL=sqlite:///./data/bugtracker.db

# Anthropic AI (Claude) — optional; static analysis works without it
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ChromaDB persistent directory for embeddings
CHROMA_PERSIST_DIR=./data/chroma

# Scanner limits
MAX_FILES_PER_SCAN=500
CLONE_TIMEOUT_SECONDS=60

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
