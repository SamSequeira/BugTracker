# BugTracker Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AWS / S3 ────────────────────────────────────────────────────────────────
# Your S3 bucket name (must already exist).
S3_BUCKET_NAME=bugtracker-repositories-577702170996-ap-south-1-an

# AWS region where the bucket lives.
AWS_REGION=ap-south-1

# AWS credentials for local development.
# NEVER put real credentials in this file.
AWS_ACCESS_KEY_ID=AKIAYNAN3SF2L2MQJ3F2
AWS_SECRET_ACCESS_KEY=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

# S3 key prefix for uploaded repository ZIPs.
S3_PREFIX=repositories

# How long pre-signed download URLs remain valid, in seconds.
S3_PRESIGNED_EXPIRY=3600

# Set to false to disable S3 uploads during local development.
S3_ENABLED=true


# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/bugtracker

# Required to sign login tokens. Generate a long random value for local use.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── AI (optional) ──────────────────────────────────────────────────────────
# Anthropic Claude — static analysis works without this.
ANTHROPIC_API_KEY=your-anthropic-api-key


# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma


# ── Scanner limits ─────────────────────────────────────────────────────────
MAX_FILES_PER_SCAN=500
CLONE_TIMEOUT_SECONDS=60


# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
